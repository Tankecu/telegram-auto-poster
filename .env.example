# Copy to .env for the live bot. The offline demo needs none of these.

# From @BotFather
BOT_TOKEN=

# Channel to publish into (the bot must be an admin there).
# Numeric id like -1001234567890 or @publicchannelname
CHANNEL_ID=

# Where confirmations go (your private chat with the bot). Optional.
OWNER_CHAT_ID=
